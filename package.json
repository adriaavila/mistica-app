    "lucide-react": "^1.8.0",
    "next": "16.2.12",
    "posthog-js": "^1.416.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "serwist": "^9.5.12",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "convex-test": "^0.0.53",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
